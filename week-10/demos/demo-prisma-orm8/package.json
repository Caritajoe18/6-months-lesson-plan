{
  "name": "demo-prisma-orm8",
  "version": "1.0.0",
  "description": "Demo: Prisma ORM 8 against PostgreSQL — contract, emit, migrations, CRUD, relations, filtering, pagination, aggregates, transactions, raw SQL",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "emit": "prisma contract emit",
    "plan": "prisma migration plan --name demo",
    "migrate": "prisma db migrate --advance-ref db",
    "db:init": "prisma db init",
    "seed": "tsx src/prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit", 
    "show-gui": "prisma studio url=http://localhost:5555"},
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.17",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^8.0.0-rc.22",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260901.1": true
  }
}
