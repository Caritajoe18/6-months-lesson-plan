{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
     "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src"]
}